---
import { KERALA_WEEKLY_SCHEMES, KERALA_BUMPERS } from '../data/schemes';
---

<footer class="bg-slate-900 text-slate-400 border-t-2 border-emerald-800 text-xs mt-10">
  <div class="max-w-4xl mx-auto px-4 py-8 space-y-6">
    
    {/* Weekly Schemes Quick Directory */}
    <div>
      <h3 class="text-white font-black text-sm uppercase tracking-wider mb-2.5 flex items-center gap-1.5">
        <span>📅</span>
        <span>Kerala Weekly Lotteries (3:00 PM Draw)</span>
      </h3>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs">
        {Object.values(KERALA_WEEKLY_SCHEMES).map(s => (
          <div class="bg-slate-800/60 p-2 rounded-xl border border-slate-700/60 flex items-center justify-between">
            <div>
              <span class="font-bold text-slate-200 block">{s.name} ({s.code})</span>
              <span class="text-[10px] text-emerald-400">{s.day} • {s.firstPrizeFormatted}</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    {/* Bumper Lotteries Section */}
    <div>
      <h3 class="text-white font-black text-sm uppercase tracking-wider mb-2 flex items-center gap-1.5">
        <span>🏆</span>
        <span>Kerala Bumper Lotteries</span>
      </h3>
      <div class="flex flex-wrap gap-2 text-[11px]">
        {KERALA_BUMPERS.map(b => (
          <span class="bg-slate-800 text-amber-300 px-2.5 py-1 rounded-lg border border-amber-500/20 font-medium">
            {b.name} ({b.firstPrize})
          </span>
        ))}
      </div>
    </div>

    {/* Disclaimer & Legal Notice */}
    <div class="bg-slate-800/50 p-4 rounded-2xl border border-slate-700/60 space-y-2.5 text-[11px] leading-relaxed text-slate-400">
      <p>
        <strong class="text-amber-300">Legal Disclaimer / നിയമപരമായ അറിയിപ്പ്:</strong> KeralaLive3PM (keralalive3pm.com) is an independent digital news and informational publishing platform. We are <strong>NOT affiliated, associated, authorized, endorsed by, or in any way officially connected with the Directorate of Kerala State Lotteries or the Government of Kerala</strong>.
      </p>
      <p>
        <strong>No Gambling or Ticket Sales:</strong> This website does NOT sell lottery tickets, accept wagers, or promote gambling. Under the Lotteries (Regulation) Act, 1998, Kerala State Lottery tickets are sold strictly in physical paper format through authorized offline vendors within the state of Kerala.
      </p>
      <p>
        <strong>Mandatory Gazette Verification:</strong> All winning numbers, prize distributions, and schedules published on this platform are compiled for public convenience and informational purposes only. Ticket holders must independently verify their numbers against the official signed Kerala Government Gazette published at <a href="https://statelottery.kerala.gov.in" target="_blank" rel="noopener noreferrer" class="text-emerald-400 hover:underline font-bold">statelottery.kerala.gov.in</a> before submitting prize claims.
      </p>
      <p class="text-slate-500 pt-1 border-t border-slate-800">
        Official Draw Location: Gorky Bhavan, Near Bakery Junction, Thiruvananthapuram, Kerala 695014 • Official Draw Time: 3:00 PM IST daily.
      </p>
    </div>

    {/* Bottom Bar */}
    <div class="pt-4 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-3 text-[11px] text-slate-500">
      <div>
        © 2026 KeralaLive3PM (keralalive3pm.com) • All rights reserved.
      </div>
      <div class="flex items-center gap-4">
        <a href="/" class="hover:text-emerald-400 transition-colors">Home</a>
        <a href="/yesterday" class="hover:text-emerald-400 transition-colors">Yesterday</a>
        <a href="/checker" class="hover:text-emerald-400 transition-colors">Ticket Checker</a>
        <a href="/disclaimer" class="hover:text-emerald-400 transition-colors">Disclaimer</a>
        <a href="/terms" class="hover:text-emerald-400 transition-colors">Terms</a>
      </div>
    </div>

  </div>
</footer>
