---
const currentPath = Astro.url.pathname;
---

<header class="bg-gradient-to-r from-emerald-950 via-emerald-900 to-emerald-950 text-white border-b-2 border-amber-500 shadow-md sticky top-0 z-40">
  <div class="max-w-4xl mx-auto px-3 sm:px-4 py-2.5 sm:py-3 flex items-center justify-between gap-2">
    
    {/* Brand Logo & Title */}
    <a href="/" class="flex items-center gap-2 sm:gap-2.5 group">
      <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-gradient-to-br from-amber-400 to-amber-600 flex items-center justify-center font-black text-slate-950 text-sm sm:text-base shadow-xs group-hover:scale-105 transition-transform flex-shrink-0 border border-amber-200">
        3PM
      </div>
      <div>
        <div class="flex items-center gap-1.5">
          <span class="font-black text-base sm:text-lg tracking-tight text-white group-hover:text-amber-400 transition-colors">
            KeralaLive<span class="text-amber-400">3PM</span>
          </span>
          <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full text-[9px] font-black bg-red-600 text-white uppercase tracking-wider animate-pulse">
            <span class="w-1.5 h-1.5 rounded-full bg-white"></span>
            LIVE
          </span>
        </div>
        <p class="text-[10px] sm:text-[11px] text-emerald-200 font-medium leading-none">
          Official Kerala State Lottery Result • കേരള ലോട്ടറി
        </p>
      </div>
    </a>

    {/* Header Navigation & CTA */}
    <nav class="flex items-center gap-1.5 sm:gap-2 text-xs font-bold">
      <a
        href="/"
        class={`px-2.5 py-1.5 rounded-xl transition-all ${
          currentPath === '/' ? 'bg-emerald-800 text-amber-300 shadow-inner' : 'text-emerald-100 hover:text-white hover:bg-emerald-800/50'
        }`}
      >
        Today
      </a>
      <a
        href="/yesterday"
        class={`px-2.5 py-1.5 rounded-xl transition-all ${
          currentPath === '/yesterday' ? 'bg-emerald-800 text-amber-300 shadow-inner' : 'text-emerald-100 hover:text-white hover:bg-emerald-800/50'
        }`}
      >
        Yesterday
      </a>
      <a
        href="/checker"
        class={`hidden sm:inline-block px-2.5 py-1.5 rounded-xl transition-all ${
          currentPath === '/checker' ? 'bg-emerald-800 text-amber-300 shadow-inner' : 'text-emerald-100 hover:text-white hover:bg-emerald-800/50'
        }`}
      >
        Checker
      </a>
      <a
        href="https://whatsapp.com/channel/0029Vb4q8j98KMqk" 
        target="_blank"
        rel="noopener noreferrer"
        class="bg-[#25d366] hover:bg-[#20bd5a] text-slate-950 font-black text-xs px-2.5 sm:px-3 py-1.5 rounded-xl flex items-center gap-1 shadow-xs transition-all active:scale-95 flex-shrink-0"
      >
        <span>💬</span>
        <span class="hidden sm:inline">WhatsApp</span>
      </a>
    </nav>
  </div>
</header>
