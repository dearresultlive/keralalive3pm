---
import SEOHead from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  faqSchema?: Array<{ question: string; answer: string }>;
  articleSchema?: {
    headline: string;
    datePublished: string;
    dateModified: string;
    description: string;
  };
  breadcrumbs?: Array<{ name: string; url: string }>;
}

const {
  title,
  description,
  canonical,
  ogImage,
  faqSchema,
  articleSchema,
  breadcrumbs,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <SEOHead
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      faqSchema={faqSchema}
      articleSchema={articleSchema}
      breadcrumbs={breadcrumbs}
    />
  </head>
  <body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col font-sans selection:bg-emerald-500 selection:text-slate-950 antialiased">
    <!-- Announcement / Breaking Bar -->
    <div class="bg-gradient-to-r from-emerald-900 via-emerald-800 to-emerald-950 border-b border-emerald-500/20 px-3 py-1.5 text-xs text-center text-emerald-200">
      <div class="max-w-7xl mx-auto flex items-center justify-center gap-2 font-medium">
        <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
        <span>Kerala State Lottery Draw at <strong>3:00 PM IST Daily</strong> (Gorky Bhavan)</span>
        <span class="hidden sm:inline text-emerald-400/60">•</span>
        <span class="hidden sm:inline text-amber-300 font-semibold">1st Prize ₹75 Lakh - ₹1 Crore Guaranteed</span>
      </div>
    </div>

    <!-- Main Navigation Header -->
    <Header />

    <!-- Page Content -->
    <main class="flex-1 w-full max-w-7xl mx-auto px-3 sm:px-4 lg:px-6 py-4 sm:py-6">
      <slot />
    </main>

    <!-- Floating Mobile Bottom Quick Actions (Responsive 5-Column Grid, Zero Overflow) -->
    <div class="md:hidden fixed bottom-0 left-0 right-0 z-40 bg-slate-950/95 backdrop-blur-md border-t border-slate-800 px-1 py-1.5 pb-[calc(0.375rem+env(safe-area-inset-bottom,0px))] grid grid-cols-5 text-center text-[10px] shadow-2xl">
      <a
        href="/"
        class="flex flex-col items-center justify-center p-0.5 text-emerald-400 hover:text-emerald-300 transition-colors min-w-0"
      >
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        <span class="font-medium truncate w-full">3 PM Live</span>
      </a>

      <a
        href="/checker"
        class="flex flex-col items-center justify-center p-0.5 text-slate-300 hover:text-white transition-colors min-w-0"
      >
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
        </svg>
        <span class="truncate w-full">Checker</span>
      </a>

      <a
        href="/chart"
        class="flex flex-col items-center justify-center p-0.5 text-slate-300 hover:text-white transition-colors min-w-0"
      >
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
        </svg>
        <span class="truncate w-full">3D Chart</span>
      </a>

      <a
        href="/yesterday"
        class="flex flex-col items-center justify-center p-0.5 text-slate-300 hover:text-white transition-colors min-w-0"
      >
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span class="truncate w-full">Yesterday</span>
      </a>

      <a
        href="https://whatsapp.com/channel/keralalottery3pm"
        target="_blank"
        rel="noopener noreferrer"
        class="flex flex-col items-center justify-center p-0.5 text-emerald-400 hover:text-emerald-300 transition-colors min-w-0"
      >
        <svg class="w-5 h-5 shrink-0 text-emerald-400" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.97.53 1.83.82 2.796.82 3.183 0 5.768-2.587 5.768-5.766.001-3.187-2.575-5.77-5.768-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.634.055-1.045-.077-.24-.078-.549-.187-.946-.358-1.688-.727-2.783-2.455-2.868-2.569-.085-.113-.687-.912-.687-1.739 0-.827.433-1.233.586-1.393.153-.16.335-.202.447-.202.112 0 .224.002.321.006.103.004.241-.039.376.286.14.336.478 1.164.52 1.25.042.085.07.186.014.298-.056.112-.085.184-.169.282-.085.099-.177.221-.253.298-.085.085-.173.177-.074.347.099.17.441.728.948 1.178.653.58 1.204.76 1.374.845.17.085.27.071.371-.043.102-.114.433-.505.549-.678.115-.173.23-.144.388-.085.158.058 1.003.473 1.175.558.172.085.287.128.329.2.042.072.042.418-.102.823z" />
        </svg>
        <span class="text-emerald-400 font-bold truncate w-full">Alerts</span>
      </a>
    </div>

    <!-- Main Footer -->
    <div class="mb-14 md:mb-0">
      <Footer />
    </div>
  </body>
</html>
