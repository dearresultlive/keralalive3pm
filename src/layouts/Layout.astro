---
import SEOHead from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  faqSchema?: Array<{ question: string; answer: string }>;
  articleSchema?: {
    headline: string;
    datePublished: string;
    dateModified: string;
    description: string;
  };
  breadcrumbs?: Array<{ name: string; url: string }>;
}

const {
  title,
  description,
  canonical,
  ogImage,
  faqSchema,
  articleSchema,
  breadcrumbs,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <SEOHead
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      faqSchema={faqSchema}
      articleSchema={articleSchema}
      breadcrumbs={breadcrumbs}
    />
  </head>
  <body class="bg-slate-100 text-slate-900 min-h-screen flex flex-col font-sans selection:bg-emerald-600 selection:text-white antialiased">
    <!-- Announcement / Breaking Bar -->
    <div class="bg-gradient-to-r from-emerald-950 via-emerald-900 to-emerald-950 border-b border-amber-500/30 px-3 py-1.5 text-xs text-center text-emerald-100">
      <div class="max-w-7xl mx-auto flex items-center justify-center gap-2 font-medium">
        <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
        <span>Kerala State Lottery Draw at <strong>3:00 PM IST Daily</strong> (Gorky Bhavan)</span>
        <span class="hidden sm:inline text-emerald-400/60">•</span>
        <span class="hidden sm:inline text-amber-300 font-semibold">1st Prize ₹75 Lakh - ₹1 Crore Guaranteed</span>
      </div>
    </div>

    <!-- Main Navigation Header -->
    <Header />

    <!-- Page Content -->
    <main class="flex-1 w-full max-w-7xl mx-auto px-3 sm:px-4 lg:px-6 py-4 sm:py-6">
      <slot />
    </main>

    <!-- Floating Mobile Bottom Quick Actions (Responsive 5-Column Grid, Zero Overflow) -->
    <div class="md:hidden fixed bottom-0 left-0 right-0 z-40 bg-white/95 backdrop-blur-md border-t border-slate-200 px-1 py-1.5 pb-[calc(0.375rem+env(safe-area-inset-bottom,0px))] grid grid-cols-5 text-center text-[10px] shadow-[0_-4px_20px_rgba(0,0,0,0.08)]">
      <a
        href="/"
        class="flex flex-col items-center justify-center p-0.5 text-emerald-700 hover:text-emerald-800 transition-colors min-w-0"
      >
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        <span class="font-bold truncate w-full">3 PM Live</span>
      </a>

      <a
        href="/checker"
        class="flex flex-col items-center justify-center p-0.5 text-slate-600 hover:text-slate-900 transition-colors min-w-0"
      >
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
        </svg>
        <span class="truncate w-full font-medium">Checker</span>
      </a>

      <a
        href="/chart"
        class="flex flex-col items-center justify-center p-0.5 text-slate-600 hover:text-slate-900 transition-colors min-w-0"
      >
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
        </svg>
        <span class="truncate w-full font-medium">3D Chart</span>
      </a>

      <a
        href="/yesterday"
        class="flex flex-col items-center justify-center p-0.5 text-slate-600 hover:text-slate-900 transition-colors min-w-0"
      >
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span class="truncate w-full font-medium">Yesterday</span>
      </a>

      <!-- 5th Tab: Install PWA App Button (Replaced WhatsApp Alerts) -->
      <button
        type="button"
        id="pwa-install-nav-btn"
        class="flex flex-col items-center justify-center p-0.5 text-amber-700 hover:text-amber-800 transition-colors min-w-0 group cursor-pointer"
        aria-label="Install Kerala Live 3PM App"
      >
        <div class="relative">
          <svg class="w-5 h-5 shrink-0 text-amber-700 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
          </svg>
          <span class="absolute -top-1 -right-1 flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-500 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-600"></span>
          </span>
        </div>
        <span class="text-amber-700 font-bold truncate w-full">App</span>
      </button>
    </div>

    <!-- PWA Install Modal Dialog -->
    <div id="pwa-install-modal" class="hidden fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-sm flex items-end sm:items-center justify-center p-4">
      <div class="bg-white border border-slate-200 rounded-3xl p-5 sm:p-6 w-full max-w-sm text-center shadow-2xl space-y-4 animate-in fade-in slide-in-from-bottom duration-200">
        <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-amber-400 to-amber-600 mx-auto flex items-center justify-center font-black text-slate-950 text-2xl shadow-lg border border-amber-200">
          3PM
        </div>
        <div>
          <h3 class="text-lg font-black text-slate-900">KeralaLive3PM App</h3>
          <p class="text-xs text-emerald-700 font-bold">കേരള ലോട്ടറി ലൈവ് ആപ്പ്</p>
          <p class="text-xs text-slate-600 mt-2">
            Install on your phone for instant 1-tap live 3:00 PM results & offline ticket checking!
          </p>
        </div>

        <div class="bg-slate-50 p-3 rounded-2xl border border-slate-200 text-left text-xs space-y-2 text-slate-700">
          <div class="flex items-center gap-2">
            <span>⚡</span>
            <span>Fastest 3:00 PM live winning numbers</span>
          </div>
          <div class="flex items-center gap-2">
            <span>🎟️</span>
            <span>Instant 6-digit ticket checker</span>
          </div>
          <div class="flex items-center gap-2">
            <span>📲</span>
            <span>No App Store needed • 1-Click Install</span>
          </div>
        </div>

        <!-- Android / Desktop Install Action -->
        <div id="pwa-action-android" class="space-y-2">
          <button
            type="button"
            id="pwa-confirm-install-btn"
            class="w-full bg-gradient-to-r from-emerald-700 to-emerald-600 hover:from-emerald-600 hover:to-emerald-500 text-white font-black py-3 rounded-xl shadow-md transition-all active:scale-95 text-sm cursor-pointer"
          >
            Install App Now (Free)
          </button>
        </div>

        <!-- iOS Safari Instructions -->
        <div id="pwa-action-ios" class="hidden text-xs text-slate-700 bg-emerald-50 p-3 rounded-2xl border border-emerald-200 text-left space-y-1.5">
          <div class="font-bold text-amber-900">How to install on iPhone/iPad:</div>
          <div>1. Tap the <strong class="text-slate-900">Share icon (📤)</strong> at bottom of Safari.</div>
          <div>2. Scroll down & tap <strong class="text-slate-900">"Add to Home Screen" ➕</strong>.</div>
          <div>3. Tap <strong class="text-slate-900">Add</strong> in top-right.</div>
        </div>

        <button
          type="button"
          id="pwa-modal-close"
          class="w-full text-slate-500 hover:text-slate-900 text-xs font-bold py-2 transition-colors cursor-pointer"
        >
          Not Now, Continue in Browser
        </button>
      </div>
    </div>

    <!-- Main Footer -->
    <div class="mb-16 md:mb-0 pb-4">
      <Footer />
    </div>

    <!-- PWA Install & Service Worker Logic -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }

      let deferredPrompt = null;
      const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;

      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        deferredPrompt = e;
      });

      const navBtn = document.getElementById('pwa-install-nav-btn');
      const modal = document.getElementById('pwa-install-modal');
      const modalClose = document.getElementById('pwa-modal-close');
      const confirmBtn = document.getElementById('pwa-confirm-install-btn');
      const iosGuide = document.getElementById('pwa-action-ios');
      const androidAction = document.getElementById('pwa-action-android');

      function openPwaModal() {
        if (!modal) return;
        if (isIOS) {
          if (iosGuide) iosGuide.classList.remove('hidden');
          if (androidAction) androidAction.classList.add('hidden');
        } else {
          if (iosGuide) iosGuide.classList.add('hidden');
          if (androidAction) androidAction.classList.remove('hidden');
        }
        modal.classList.remove('hidden');
      }

      function closePwaModal() {
        if (modal) modal.classList.add('hidden');
      }

      if (navBtn) {
        navBtn.addEventListener('click', (e) => {
          e.preventDefault();
          if (deferredPrompt) {
            deferredPrompt.prompt();
            deferredPrompt.userChoice.then((choiceResult) => {
              if (choiceResult.outcome === 'accepted') {
                deferredPrompt = null;
              }
            });
          } else {
            openPwaModal();
          }
        });
      }

      if (confirmBtn) {
        confirmBtn.addEventListener('click', () => {
          if (deferredPrompt) {
            deferredPrompt.prompt();
            deferredPrompt.userChoice.then(() => {
              deferredPrompt = null;
              closePwaModal();
            });
          } else {
            alert('To install: Tap your browser menu (⋮) and tap "Install app" or "Add to Home screen".');
            closePwaModal();
          }
        });
      }

      if (modalClose) {
        modalClose.addEventListener('click', closePwaModal);
      }

      if (modal) {
        modal.addEventListener('click', (e) => {
          if (e.target === modal) closePwaModal();
        });
      }
    </script>
  </body>
</html>
