---
import Layout from '../layouts/Layout.astro';
import KeralaGuessingChart from '../components/KeralaGuessingChart';

// Cloudflare Edge micro-caching (30s edge cache, 15s browser cache) for peak 3:00 PM rush
Astro.response.headers.set('Cache-Control', 'public, max-age=15, s-maxage=30, stale-while-revalidate=60');

const pageTitle = "Kerala Lottery Guessing Number Today 3 PM (A, B, C Board & 3D Chart) | keralalive3pm.com";
const pageDescription = "Daily Kerala State Lottery 3-digit guessing numbers, A B C board prediction combinations, repeating hot/cold frequency analysis, and statistical 3D lucky number generator.";

const faqItems = [
  {
    question: "What is A, B, C Board in Kerala Lottery?",
    answer: "In Kerala 3-digit number analysis, 'A Board' represents the hundreds digit, 'B Board' represents the tens digit, and 'C Board' represents the units/ones digit of the last 3 winning numbers."
  },
  {
    question: "Are Kerala lottery guessing numbers guaranteed to win?",
    answer: "No. Kerala State Lottery draws are completely random mechanical physical draws conducted by government officials. Guessing numbers and board charts are calculated based on mathematical probability and historical frequency patterns for informational and entertainment purposes only."
  },
  {
    question: "What are repeating number combinations?",
    answer: "Repeating combinations are 3-digit pairs and triplets that have historically appeared in 3rd through 8th prize tiers multiple times across previous weekly draws."
  }
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="https://keralalive3pm.com/chart"
  faqSchema={faqItems}
  breadcrumbs={[
    { name: "Home", url: "https://keralalive3pm.com" },
    { name: "3D Guessing & Chart", url: "https://keralalive3pm.com/chart" }
  ]}
>
  <div class="max-w-4xl mx-auto space-y-6">
    <!-- Header Card -->
    <div class="bg-white border border-slate-200 rounded-3xl p-5 sm:p-6 text-center space-y-2 shadow-sm">
      <nav class="flex items-center justify-center gap-2 text-xs text-slate-500 font-mono mb-1">
        <a href="/" class="hover:text-emerald-700 transition-colors">Home</a>
        <span>/</span>
        <span class="text-emerald-700 font-bold">3D Guessing & Chart</span>
      </nav>
      <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
        Kerala Lottery 3-Digit Guessing Chart
      </h1>
      <p class="text-xs sm:text-sm text-slate-600 max-w-lg mx-auto">
        A/B/C single board analysis, high-frequency pairs, and historical statistical probability trends for today's 3:00 PM draw.
      </p>
    </div>

    <!-- Interactive Guessing Island -->
    <KeralaGuessingChart client:load />

    <!-- Educational & Disclaimer Section -->
    <div class="bg-white border border-slate-200 rounded-3xl p-5 sm:p-6 space-y-4 text-xs sm:text-sm text-slate-700 shadow-sm">
      <h2 class="text-base font-black text-slate-900 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-600"></span>
        Understanding Kerala 3D Board Analysis
      </h2>
      <p>
        Kerala lottery players study historical draw results by isolating the trailing 3 digits into three boards:
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2">
        <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200 text-center">
          <div class="font-black text-emerald-800 text-base mb-1">Board A</div>
          <p class="text-slate-600 text-xs">Hundreds Place (X - -)<br />Calculated from 1st digit of 3-digit sequence.</p>
        </div>
        <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200 text-center">
          <div class="font-black text-amber-800 text-base mb-1">Board B</div>
          <p class="text-slate-600 text-xs">Tens Place (- X -)<br />Calculated from 2nd digit of 3-digit sequence.</p>
        </div>
        <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200 text-center">
          <div class="font-black text-sky-800 text-base mb-1">Board C</div>
          <p class="text-slate-600 text-xs">Units Place (- - X)<br />Calculated from 3rd digit of 3-digit sequence.</p>
        </div>
      </div>
      <p class="text-[11px] text-slate-500 pt-2 border-t border-slate-100">
        *Disclaimer: keralalive3pm.com does not promote gambling or guarantee winning numbers. All guessing statistics are computer-generated based on past lottery results for research and entertainment purposes.
      </p>
    </div>

    <!-- FAQ Accordion -->
    <div class="bg-white border border-slate-200 rounded-3xl p-5 sm:p-6 space-y-3 shadow-sm">
      <h3 class="text-base font-black text-slate-900 mb-2">Frequently Asked Questions</h3>
      {faqItems.map((faq) => (
        <details class="bg-slate-50 p-4 rounded-2xl border border-slate-200">
          <summary class="font-bold text-slate-900 text-sm cursor-pointer">{faq.question}</summary>
          <p class="mt-2 text-xs sm:text-sm text-slate-600">{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</Layout>
