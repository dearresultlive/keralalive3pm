---
import Layout from '../layouts/Layout.astro';
import keralaDraws from '../data/kerala_draws.json';
import { getYesterdayKeralaScheme, formatIndianRupees } from '../lib/kerala-utils';

const yesterdayScheme = getYesterdayKeralaScheme();

// Get the latest draw or matching draw
const allDraws = Object.values(keralaDraws);
const yesterdayDraw = allDraws.length > 1 ? allDraws[1] : allDraws[0];

const pageTitle = `Kerala Lottery Result Yesterday 3 PM - ${yesterdayScheme.name} (${yesterdayDraw?.drawNumber || yesterdayScheme.code}) | keralalive3pm.in`;
const pageDescription = `Check yesterday's Kerala State Lottery 3:00 PM result for ${yesterdayScheme.name}. Complete 1st prize ${yesterdayScheme.firstPrizeFormatted}, consolation, and 2nd to 8th prize winning numbers.`;

const faqItems = [
  {
    question: `What was yesterday's Kerala Lottery result?`,
    answer: `Yesterday's Kerala Lottery draw was ${yesterdayScheme.name} (${yesterdayDraw?.drawNumber || yesterdayScheme.code}). The 1st prize was won by ticket ${yesterdayDraw?.prizes.first.ticket || 'Check table'} with a prize amount of ${yesterdayScheme.firstPrizeFormatted}.`
  },
  {
    question: "Can I claim yesterday's winning Kerala lottery ticket today?",
    answer: "Yes, winning tickets can be claimed within 30 days from the date of the draw at authorized district lottery offices or the Directorate of State Lotteries in Thiruvananthapuram."
  }
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="https://keralalive3pm.in/yesterday"
  faqSchema={faqItems}
  breadcrumbs={[
    { name: "Home", url: "https://keralalive3pm.in" },
    { name: "Yesterday Result", url: "https://keralalive3pm.in/yesterday" }
  ]}
>
  <div class="space-y-6">
    <!-- Breadcrumb & Title Header -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 sm:p-6">
      <nav class="flex items-center gap-2 text-xs text-slate-400 mb-2 font-mono">
        <a href="/" class="hover:text-emerald-400 transition-colors">Home</a>
        <span>/</span>
        <span class="text-emerald-400">Yesterday Result</span>
      </nav>

      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <h1 class="text-xl sm:text-2xl lg:text-3xl font-black text-white tracking-tight">
            Kerala Lottery Result Yesterday (3:00 PM)
          </h1>
          <p class="text-xs sm:text-sm text-slate-400 mt-1">
            Draw Scheme: <strong class="text-emerald-400">{yesterdayScheme.name}</strong> • Date: <span class="font-mono text-slate-200">{yesterdayDraw?.date || 'Yesterday'}</span>
          </p>
        </div>
        <a
          href="/"
          class="inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-4 py-2 rounded-xl text-xs transition-all w-fit"
        >
          <span class="w-2 h-2 rounded-full bg-white animate-pulse"></span>
          View Today's Live Result
        </a>
      </div>
    </div>

    <!-- 1st Prize Highlight Card -->
    {yesterdayDraw && (
      <div class="bg-gradient-to-br from-amber-950/40 via-slate-900 to-slate-950 border-2 border-amber-500/40 rounded-2xl p-5 sm:p-8 text-center shadow-2xl relative overflow-hidden">
        <div class="absolute top-0 right-0 bg-amber-500 text-slate-950 text-xs font-black uppercase px-4 py-1 rounded-bl-xl tracking-wider">
          Official 1st Prize Winner
        </div>

        <div class="inline-block bg-amber-500/10 text-amber-300 border border-amber-500/30 px-3 py-1 rounded-full text-xs font-semibold mb-3">
          1st Prize: {formatIndianRupees(yesterdayDraw.prizes.first.amount)}
        </div>

        <div class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-widest text-amber-400 font-mono my-3 selection:bg-amber-300 selection:text-slate-950 drop-shadow-[0_0_20px_rgba(245,158,11,0.3)]">
          {yesterdayDraw.prizes.first.ticket}
        </div>

        <p class="text-xs sm:text-sm text-slate-400">
          Drawn at Gorky Bhavan, Thiruvananthapuram • Complete 6-digit ticket with series
        </p>
      </div>
    )}

    <!-- Full Prize Breakdown Table -->
    {yesterdayDraw && (
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 sm:p-6 space-y-6">
        <div class="flex items-center justify-between border-b border-slate-800 pb-3">
          <h2 class="text-lg font-bold text-white flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
            Full Prize Breakdown (1st to 8th Prize)
          </h2>
          <span class="text-xs bg-slate-800 text-slate-300 px-3 py-1 rounded-full font-mono">
            {yesterdayDraw.drawNumber}
          </span>
        </div>

        <!-- Consolation Prize -->
        {yesterdayDraw.prizes.consolation.length > 0 && (
          <div class="bg-slate-950/60 p-4 rounded-xl border border-slate-800/80">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold uppercase tracking-wider text-amber-400">Consolation Prize</span>
              <span class="text-xs font-semibold text-slate-300">₹8,000 Each</span>
            </div>
            <div class="flex flex-wrap gap-2">
              {yesterdayDraw.prizes.consolation.map((ticket: string) => (
                <span class="font-mono text-sm bg-slate-900 px-3 py-1 rounded-lg text-slate-200 border border-slate-800 font-medium">
                  {ticket}
                </span>
              ))}
            </div>
          </div>
        )}

        <!-- 2nd Prize -->
        {yesterdayDraw.prizes.second.length > 0 && (
          <div class="bg-slate-950/60 p-4 rounded-xl border border-slate-800/80">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold uppercase tracking-wider text-emerald-400">2nd Prize</span>
              <span class="text-xs font-semibold text-slate-300">₹5,00,000 Each</span>
            </div>
            <div class="flex flex-wrap gap-2">
              {yesterdayDraw.prizes.second.map((ticket: string) => (
                <span class="font-mono text-sm bg-slate-900 px-3 py-1 rounded-lg text-slate-200 border border-slate-800 font-medium">
                  {ticket}
                </span>
              ))}
            </div>
          </div>
        )}

        <!-- 3rd to 8th Prize Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {yesterdayDraw.prizes.third.length > 0 && (
            <div class="bg-slate-950/60 p-3.5 rounded-xl border border-slate-800/80">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-bold text-slate-300 uppercase">3rd Prize (₹5,000)</span>
                <span class="text-[11px] text-slate-400 font-mono">Last 4 digits</span>
              </div>
              <div class="flex flex-wrap gap-1.5 font-mono text-xs">
                {yesterdayDraw.prizes.third.map((num: string) => (
                  <span class="bg-slate-900 px-2 py-0.5 rounded text-slate-200 border border-slate-800">{num}</span>
                ))}
              </div>
            </div>
          )}

          {yesterdayDraw.prizes.fourth.length > 0 && (
            <div class="bg-slate-950/60 p-3.5 rounded-xl border border-slate-800/80">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-bold text-slate-300 uppercase">4th Prize (₹2,000)</span>
                <span class="text-[11px] text-slate-400 font-mono">Last 4 digits</span>
              </div>
              <div class="flex flex-wrap gap-1.5 font-mono text-xs">
                {yesterdayDraw.prizes.fourth.map((num: string) => (
                  <span class="bg-slate-900 px-2 py-0.5 rounded text-slate-200 border border-slate-800">{num}</span>
                ))}
              </div>
            </div>
          )}

          {yesterdayDraw.prizes.fifth.length > 0 && (
            <div class="bg-slate-950/60 p-3.5 rounded-xl border border-slate-800/80">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-bold text-slate-300 uppercase">5th Prize (₹1,000)</span>
                <span class="text-[11px] text-slate-400 font-mono">Last 4 digits</span>
              </div>
              <div class="flex flex-wrap gap-1.5 font-mono text-xs">
                {yesterdayDraw.prizes.fifth.map((num: string) => (
                  <span class="bg-slate-900 px-2 py-0.5 rounded text-slate-200 border border-slate-800">{num}</span>
                ))}
              </div>
            </div>
          )}

          {yesterdayDraw.prizes.sixth.length > 0 && (
            <div class="bg-slate-950/60 p-3.5 rounded-xl border border-slate-800/80">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-bold text-slate-300 uppercase">6th Prize (₹500)</span>
                <span class="text-[11px] text-slate-400 font-mono">Last 4 digits</span>
              </div>
              <div class="flex flex-wrap gap-1.5 font-mono text-xs">
                {yesterdayDraw.prizes.sixth.map((num: string) => (
                  <span class="bg-slate-900 px-2 py-0.5 rounded text-slate-200 border border-slate-800">{num}</span>
                ))}
              </div>
            </div>
          )}

          {yesterdayDraw.prizes.seventh.length > 0 && (
            <div class="bg-slate-950/60 p-3.5 rounded-xl border border-slate-800/80">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-bold text-slate-300 uppercase">7th Prize (₹100)</span>
                <span class="text-[11px] text-slate-400 font-mono">Last 4 digits</span>
              </div>
              <div class="flex flex-wrap gap-1.5 font-mono text-xs">
                {yesterdayDraw.prizes.seventh.map((num: string) => (
                  <span class="bg-slate-900 px-2 py-0.5 rounded text-slate-200 border border-slate-800">{num}</span>
                ))}
              </div>
            </div>
          )}

          {yesterdayDraw.prizes.eighth.length > 0 && (
            <div class="bg-slate-950/60 p-3.5 rounded-xl border border-slate-800/80">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-bold text-slate-300 uppercase">8th Prize (₹100)</span>
                <span class="text-[11px] text-slate-400 font-mono">Last 4 digits</span>
              </div>
              <div class="flex flex-wrap gap-1.5 font-mono text-xs">
                {yesterdayDraw.prizes.eighth.map((num: string) => (
                  <span class="bg-slate-900 px-2 py-0.5 rounded text-slate-200 border border-slate-800">{num}</span>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    )}

    <!-- FAQ Accordion -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 space-y-4">
      <h3 class="text-base font-bold text-white">Frequently Asked Questions</h3>
      <div class="space-y-3">
        {faqItems.map((faq) => (
          <details class="bg-slate-950 p-4 rounded-xl border border-slate-800">
            <summary class="font-semibold text-white text-sm cursor-pointer">{faq.question}</summary>
            <p class="mt-2 text-xs sm:text-sm text-slate-400">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </div>
</Layout>
