---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Terms of Service | keralalive3pm.in";
const pageDescription = "Terms and conditions of using keralalive3pm.in.";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="https://keralalive3pm.in/terms"
>
  <div class="max-w-3xl mx-auto space-y-6">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-8 space-y-4">
      <h1 class="text-2xl sm:text-3xl font-black text-white">Terms of Service</h1>
      <p class="text-xs text-slate-400">Last updated: October 2026</p>

      <div class="space-y-4 text-sm text-slate-300 leading-relaxed pt-2">
        <h2 class="text-lg font-bold text-white">1. Agreement to Terms</h2>
        <p>
          By accessing or using keralalive3pm.in, you agree to be bound by these Terms of Service. If you disagree with any part of these terms, you may not access the service.
        </p>

        <h2 class="text-lg font-bold text-white pt-2">2. Accuracy and Non-Affiliation</h2>
        <p>
          All lottery results published on this website are collected from publicly accessible government publications and live broadcasts. We do not represent or act as agents for the Kerala State Lottery Directorate.
        </p>

        <h2 class="text-lg font-bold text-white pt-2">3. Intellectual Property</h2>
        <p>
          The layout, design, graphics, ticket checker logic, and guessing algorithms of keralalive3pm.in are the intellectual property of this site. Content may not be copied, distributed, or republished without written consent.
        </p>

        <h2 class="text-lg font-bold text-white pt-2">4. Age Restrictions</h2>
        <p>
          Participation in paper lotteries is strictly governed by state regulations and restricted to individuals aged 18 and older. This website is meant for legal adult residents who purchase paper tickets in authorized jurisdictions.
        </p>
      </div>
    </div>
  </div>
</Layout>
