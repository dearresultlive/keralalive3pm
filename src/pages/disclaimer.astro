---
import Layout from '../layouts/Layout.astro';

// Edge cache for 24h, browser cache 1h
Astro.response.headers.set('Cache-Control', 'public, max-age=3600, s-maxage=86400, stale-while-revalidate=3600');

const pageTitle = "Disclaimer & Official Notice | keralalive3pm.com";
const pageDescription = "Official disclaimer for keralalive3pm.com. Non-governmental informational website reporting Kerala State Lottery results published by the Government of Kerala.";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="https://keralalive3pm.com/disclaimer"
>
  <div class="max-w-3xl mx-auto space-y-6">
    <div class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 space-y-4 shadow-sm">
      <h1 class="text-2xl sm:text-3xl font-black text-slate-900">Disclaimer</h1>
      <p class="text-xs text-slate-500">Last updated: October 2026</p>

      <div class="space-y-4 text-sm text-slate-700 leading-relaxed pt-2">
        <div class="bg-amber-50 border-l-4 border-amber-500 p-4 rounded-r-xl text-amber-950 text-xs sm:text-sm">
          <strong>Important Non-Affiliation Notice:</strong> keralalive3pm.com is an independent news and informational portal and is <strong>NOT affiliated, associated, authorized, endorsed by, or in any way officially connected</strong> with the Directorate of Kerala State Lotteries, Government of Kerala, or any of its subsidiaries or affiliates.
        </div>

        <h2 class="text-lg font-bold text-slate-900 pt-2">1. Informational Purposes Only</h2>
        <p>
          The contents published on keralalive3pm.com, including draw numbers, winning lists, prize amounts, and guessing charts, are provided solely for the convenience of the public and for informational purposes. While we strive to ensure maximum speed and accuracy during the 3:00 PM live draw, errors or discrepancies may inadvertently occur.
        </p>

        <h2 class="text-lg font-bold text-slate-900 pt-2">2. Official Verification Required</h2>
        <p>
          Ticket holders must independently verify all winning numbers with the official Kerala Government Gazette published by the Directorate of State Lotteries or at authorized district lottery offices before taking any action or claiming prize money.
        </p>

        <h2 class="text-lg font-bold text-slate-900 pt-2">3. No Sale of Tickets or Gambling</h2>
        <p>
          keralalive3pm.com does NOT sell lottery tickets, accept bets, process wagers, or encourage gambling. Under the Lotteries (Regulation) Act, 1998, sale of lottery tickets is strictly paper-based and handled exclusively by authorized offline agents and vendors registered in Kerala.
        </p>

        <h2 class="text-lg font-bold text-slate-900 pt-2">4. Limitation of Liability</h2>
        <p>
          In no event shall keralalive3pm.com, its operators, or contributors be held liable for any loss, damage, expense, or inconvenience arising from reliance on the information published on this website.
        </p>
      </div>
    </div>
  </div>
</Layout>
