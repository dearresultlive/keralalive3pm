---
import Layout from '../layouts/Layout.astro';

// Edge cache for 24h, browser cache 1h
Astro.response.headers.set('Cache-Control', 'public, max-age=3600, s-maxage=86400, stale-while-revalidate=3600');

const pageTitle = "Contact Us | keralalive3pm.com";
const pageDescription = "Get in touch with the editorial team at keralalive3pm.com.";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="https://keralalive3pm.com/contact"
>
  <div class="max-w-2xl mx-auto space-y-6">
    <div class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 space-y-4 shadow-sm">
      <h1 class="text-2xl sm:text-3xl font-black text-slate-900">Contact Us</h1>
      <p class="text-sm text-slate-600">
        Have questions, corrections regarding 3:00 PM draw numbers, or advertising inquiries? Feel free to reach out to our team.
      </p>

      <div class="bg-slate-50 p-5 rounded-2xl border border-slate-200 space-y-3">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-800 flex items-center justify-center font-bold">
            ✉️
          </div>
          <div>
            <div class="text-xs text-slate-500 font-medium">Editorial Support Email</div>
            <a href="mailto:support@keralalive3pm.com" class="text-emerald-800 hover:text-emerald-700 font-mono text-sm font-bold">
              support@keralalive3pm.com
            </a>
          </div>
        </div>

        <div class="flex items-center gap-3 pt-3 border-t border-slate-200">
          <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-800 flex items-center justify-center font-bold">
            💬
          </div>
          <div>
            <div class="text-xs text-slate-500 font-medium">Community Channel</div>
            <a href="https://whatsapp.com/channel/keralalottery3pm" target="_blank" rel="noopener noreferrer" class="text-emerald-800 hover:text-emerald-700 text-sm font-bold">
              Join WhatsApp Alert Channel &rarr;
            </a>
          </div>
        </div>
      </div>

      <div class="bg-amber-50 border border-amber-300 rounded-2xl p-4 text-xs text-amber-950">
        <strong>Notice regarding Prize Claims:</strong> We are a digital publishing portal and cannot process or verify physical lottery ticket claims. For official claims, please visit the Directorate of State Lotteries, Vikas Bhavan, Thiruvananthapuram, Kerala.
      </div>
    </div>
  </div>
</Layout>
