---
import Layout from '../layouts/Layout.astro';
import LiveKeralaResults from '../components/LiveKeralaResults';
import KeralaTicketChecker from '../components/KeralaTicketChecker';
import KeralaGuessingChart from '../components/KeralaGuessingChart';
import { KERALA_WEEKLY_SCHEMES, BUMPER_SCHEMES } from '../data/schemes';
import keralaDraws from '../data/kerala_draws.json';
import { getISTDateString } from '../lib/kerala-utils';

const todayDateStr = getISTDateString();

const pageTitle = "Kerala Lottery Result Today 3 PM Live (കേരള ലോട്ടറി ഫലം) | keralalive3pm.com";
const pageDescription = "Live Kerala State Lottery Result 3:00 PM today. Check Win-Win, Sthree Sakthi, Fifty Fifty, Karunya Plus, Nirmal, Karunya & Akshaya 1st to 8th prize winning numbers and 3D guessing chart.";

const faqItems = [
  {
    question: "What time is the Kerala Lottery Result announced?",
    answer: "The official Kerala State Lottery live draw starts at 3:00 PM IST daily at Gorky Bhavan, Near Bakery Junction, Thiruvananthapuram. The 1st prize is declared around 3:05 PM to 3:15 PM, and the complete official PDF with 1st to 8th prize tiers is released by 4:00 PM."
  },
  {
    question: "Where can I verify my Kerala lottery ticket?",
    answer: "You can use the instant 6-digit ticket checker on keralalive3pm.com to test your ticket against all prize tiers. You should also verify with the Kerala State Lottery Gazette or official portal (statelottery.kerala.gov.in)."
  },
  {
    question: "What are the 7 weekly Kerala State Lotteries?",
    answer: "Sunday: Akshaya (AK), Monday: Win-Win (W), Tuesday: Sthree Sakthi (SS), Wednesday: Fifty-Fifty (FF), Thursday: Karunya Plus (KN), Friday: Nirmal (NR), Saturday: Karunya (KR)."
  },
  {
    question: "What is the tax deduction (TDS) on Kerala Lottery winnings?",
    answer: "For prize money exceeding ₹10,000, 30% TDS (Income Tax under Section 194B) plus 10% lottery agent commission are deducted. The remaining amount is transferred to the winner's verified bank account."
  },
  {
    question: "How do I claim a Kerala Lottery prize?",
    answer: "Prizes up to ₹100,000 can be claimed from any authorized district lottery office. Prizes above ₹100,000 must be submitted to the Directorate of State Lotteries, Vikas Bhavan, Thiruvananthapuram along with original ticket, PAN card, Aadhaar card, and passport-size photographs within 30 days of the draw."
  }
];

const daysOrder = [1, 2, 3, 4, 5, 6, 0]; // Mon to Sun
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="https://keralalive3pm.com"
  faqSchema={faqItems}
>
  <!-- Hero / Live Results Component -->
  <section class="mb-8">
    <LiveKeralaResults client:load initialDraws={keralaDraws} todayDateStr={todayDateStr} />
  </section>

  <!-- WhatsApp & Telegram Community CTA Banner -->
  <section class="mb-8 bg-gradient-to-r from-emerald-900/40 via-emerald-800/30 to-slate-900 border border-emerald-500/30 rounded-2xl p-4 sm:p-6 text-center relative overflow-hidden">
    <div class="absolute -right-10 -bottom-10 w-40 h-40 bg-emerald-500/10 rounded-full blur-2xl pointer-events-none"></div>
    <div class="max-w-2xl mx-auto space-y-3 relative z-10">
      <div class="inline-flex items-center gap-2 bg-emerald-500/20 text-emerald-300 px-3 py-1 rounded-full text-xs font-semibold">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        Instant 3:00 PM Result Alerts
      </div>
      <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
        Join 50,000+ Kerala Lottery Players on WhatsApp
      </h2>
      <p class="text-sm text-slate-300">
        Get the 1st prize number at 3:05 PM directly on your phone before websites update. Official PDF notification at 4:00 PM.
      </p>
      <div class="pt-2 flex flex-wrap items-center justify-center gap-3">
        <a
          href="https://whatsapp.com/channel/keralalottery3pm"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-6 py-2.5 rounded-xl shadow-lg shadow-emerald-900/40 transition-all hover:scale-105 text-sm"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.97.53 1.83.82 2.796.82 3.183 0 5.768-2.587 5.768-5.766.001-3.187-2.575-5.77-5.768-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.634.055-1.045-.077-.24-.078-.549-.187-.946-.358-1.688-.727-2.783-2.455-2.868-2.569-.085-.113-.687-.912-.687-1.739 0-.827.433-1.233.586-1.393.153-.16.335-.202.447-.202.112 0 .224.002.321.006.103.004.241-.039.376.286.14.336.478 1.164.52 1.25.042.085.07.186.014.298-.056.112-.085.184-.169.282-.085.099-.177.221-.253.298-.085.085-.173.177-.074.347.099.17.441.728.948 1.178.653.58 1.204.76 1.374.845.17.085.27.071.371-.043.102-.114.433-.505.549-.678.115-.173.23-.144.388-.085.158.058 1.003.473 1.175.558.172.085.287.128.329.2.042.072.042.418-.102.823z" />
          </svg>
          Join WhatsApp Channel (Free)
        </a>
        <a
          href="https://t.me/keralalottery3pm"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-slate-800 hover:bg-slate-700 text-sky-400 font-semibold px-5 py-2.5 rounded-xl border border-slate-700 text-sm transition-all"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.52 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .39z"/>
          </svg>
          Telegram Group
        </a>
      </div>
    </div>
  </section>

  <!-- Interactive Utility Tools Section (Checker + Guessing Grid) -->
  <section class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-10">
    <div id="checker" class="scroll-mt-20">
      <KeralaTicketChecker client:idle draws={keralaDraws} />
    </div>
    <div id="guessing" class="scroll-mt-20">
      <KeralaGuessingChart client:visible />
    </div>
  </section>

  <!-- Kerala Weekly Lottery Draw Schedule Table -->
  <section class="mb-10 bg-slate-900 border border-slate-800 rounded-2xl p-5 sm:p-6 shadow-xl">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-5 border-b border-slate-800 pb-4">
      <div>
        <h2 class="text-lg sm:text-xl font-bold text-white flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
          Kerala Weekly Lottery Draw Schedule
        </h2>
        <p class="text-xs sm:text-sm text-slate-400">
          Official daily 3:00 PM draws conducted by the Government of Kerala
        </p>
      </div>
      <span class="text-xs bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 px-3 py-1 rounded-full font-medium w-fit">
        Everyday at 3:00 PM IST
      </span>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead>
          <tr class="bg-slate-950/80 text-slate-400 border-b border-slate-800 text-xs uppercase tracking-wider font-semibold">
            <th class="py-3 px-3">Day</th>
            <th class="py-3 px-3">Lottery Scheme</th>
            <th class="py-3 px-3">Code</th>
            <th class="py-3 px-3">1st Prize</th>
            <th class="py-3 px-3">Ticket Price</th>
            <th class="py-3 px-3 text-right">Draw Time</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/60 font-mono text-xs sm:text-sm">
          {daysOrder.map((dayNum) => {
            const scheme = KERALA_WEEKLY_SCHEMES[dayNum];
            const isToday = new Date().getDay() === dayNum;
            return (
              <tr class={`transition-colors ${isToday ? 'bg-emerald-950/30 border-l-4 border-l-emerald-500' : 'hover:bg-slate-800/40'}`}>
                <td class="py-3 px-3 capitalize font-sans font-medium text-slate-200">
                  {scheme.day}
                  {isToday && <span class="ml-1.5 text-[10px] bg-emerald-500 text-slate-950 font-bold px-1.5 py-0.5 rounded">TODAY</span>}
                </td>
                <td class="py-3 px-3 font-sans">
                  <div class="font-bold text-white">{scheme.name}</div>
                  <div class="text-[11px] text-emerald-400 font-malayalam">{scheme.nameMl}</div>
                </td>
                <td class="py-3 px-3">
                  <span class="bg-slate-800 text-slate-300 px-2 py-0.5 rounded text-xs border border-slate-700">
                    {scheme.code}
                  </span>
                </td>
                <td class="py-3 px-3 text-amber-300 font-bold font-sans">
                  {scheme.firstPrizeFormatted}
                </td>
                <td class="py-3 px-3 text-slate-300 font-sans">
                  ₹{scheme.ticketPrice}
                </td>
                <td class="py-3 px-3 text-right text-emerald-400 font-semibold font-sans">
                  3:00 PM
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Kerala Bumper Lotteries Spotlight -->
  <section class="mb-10 bg-gradient-to-br from-amber-950/20 via-slate-900 to-slate-950 border border-amber-500/20 rounded-2xl p-5 sm:p-6 shadow-xl">
    <div class="flex items-center justify-between mb-4">
      <div>
        <h2 class="text-lg sm:text-xl font-bold text-amber-300 flex items-center gap-2">
          <span>🏆</span> Kerala State Bumper Lotteries
        </h2>
        <p class="text-xs sm:text-sm text-slate-400">Mega draws with 1st prizes up to ₹25 Crore</p>
      </div>
      <span class="text-xs bg-amber-500/10 text-amber-300 border border-amber-500/30 px-2.5 py-1 rounded-full font-medium">
        6 Annual Bumpers
      </span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
      {BUMPER_SCHEMES.map((bumper) => (
        <div class="bg-slate-950/70 border border-amber-500/20 rounded-xl p-3.5 hover:border-amber-500/40 transition-all">
          <div class="flex items-center justify-between text-xs text-slate-400 mb-1">
            <span class="font-mono bg-amber-500/10 text-amber-400 px-1.5 py-0.5 rounded">{bumper.code}</span>
            <span>{bumper.drawMonth}</span>
          </div>
          <div class="font-bold text-white text-sm">{bumper.name}</div>
          <div class="text-xs text-amber-400/80 font-malayalam mb-2">{bumper.nameMl}</div>
          <div class="flex items-center justify-between pt-2 border-t border-slate-800 text-xs">
            <span class="text-slate-400">1st Prize</span>
            <span class="font-bold text-amber-300">{bumper.firstPrize}</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- In-Depth SEO Informational Guide & Authority Content -->
  <article class="bg-slate-900/60 border border-slate-800 rounded-2xl p-5 sm:p-7 space-y-6 text-slate-300 text-sm leading-relaxed mb-10">
    <div>
      <h2 class="text-xl sm:text-2xl font-bold text-white mb-2">
        About Kerala State Lotteries (കേരള സംസ്ഥാന ഭാഗ്യക്കുറി)
      </h2>
      <p>
        Established in 1967, the Kerala State Lotteries is the first of its kind in India. Run by the Directorate of State Lotteries under the Taxes Department, Government of Kerala, the lottery system supports social welfare programs across the state while offering completely transparent, randomized public draws.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
      <div class="bg-slate-950/80 p-4 rounded-xl border border-slate-800">
        <div class="text-emerald-400 font-bold mb-1">⏰ Daily 3:00 PM Draw</div>
        <p class="text-xs text-slate-400">
          The manual mechanical draw begins at 3:00 PM IST at Gorky Bhavan, Thiruvananthapuram before a panel of appointed judges.
        </p>
      </div>
      <div class="bg-slate-950/80 p-4 rounded-xl border border-slate-800">
        <div class="text-amber-400 font-bold mb-1">🎯 8 Prize Tiers</div>
        <p class="text-xs text-slate-400">
          Weekly tickets have 8 full prize tiers ranging from ₹75,00,000 down to ₹100, plus multiple ₹8,000 consolation prizes.
        </p>
      </div>
      <div class="bg-slate-950/80 p-4 rounded-xl border border-slate-800">
        <div class="text-sky-400 font-bold mb-1">📜 Official Gazette</div>
        <p class="text-xs text-slate-400">
          All winning numbers published on this portal are cross-checked with the official government gazette bulletin for 100% accuracy.
        </p>
      </div>
    </div>

    <div>
      <h3 class="text-lg font-bold text-white mb-2">
        How to Claim Kerala Lottery Prize Money
      </h3>
      <ol class="list-decimal pl-5 space-y-1.5 text-xs sm:text-sm text-slate-300">
        <li><strong>Verify Ticket:</strong> Cross-check your 6-digit number and series letters with the official Kerala Gazette result.</li>
        <li><strong>Sign the Back:</strong> Write your name, signature, and phone number on the back of the winning ticket immediately.</li>
        <li><strong>Below ₹1,00,000:</strong> Can be surrendered and claimed at any District Lottery Office (DLO) in Kerala.</li>
        <li><strong>Above ₹1,00,000:</strong> Must be presented to the Director of State Lotteries, Vikas Bhavan, Thiruvananthapuram within 30 days of the draw.</li>
        <li><strong>Documents Required:</strong> Original ticket, claim application form, self-attested PAN card copy, Aadhaar card copy, and 2 passport-size photos attested by a Gazetted Officer.</li>
      </ol>
    </div>

    <!-- FAQ Accordion List -->
    <div class="pt-4 border-t border-slate-800">
      <h3 class="text-lg font-bold text-white mb-4">
        Frequently Asked Questions (FAQ)
      </h3>
      <div class="space-y-3">
        {faqItems.map((faq) => (
          <details class="group bg-slate-950/70 border border-slate-800 rounded-xl p-4 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex cursor-pointer items-center justify-between gap-1.5 text-white font-semibold text-sm">
              <span>{faq.question}</span>
              <span class="shrink-0 transition duration-300 group-open:-rotate-180 text-emerald-400">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-slate-400 leading-relaxed border-t border-slate-800/60 pt-3">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </div>
  </article>
</Layout>
